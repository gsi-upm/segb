# SEGB example environment file
#
# Minimal setup for centralized docker-compose deployment:
#   cp .env.example .env
#
# Required by Virtuoso + backend startup.
VIRTUOSO_PASSWORD=change-this-password
# Dedicated account for GET /query. Compose provisions it before starting the backend.
# Use a different password from VIRTUOSO_PASSWORD; neither value may be empty.
VIRTUOSO_READER_USER=segb_reader
VIRTUOSO_READER_PASSWORD=change-this-reader-password
# Important:
# - This value initializes Virtuoso DBA password only when `virtuoso_data` is created the first time.
# - If you change this value later and keep existing `virtuoso_data`, Virtuoso keeps the old password.
# - To apply a new password, recreate data volume (destructive):
#     docker compose -f docker-compose.yaml down -v

# Optional: enable backend JWT auth.
# - Set non-empty SECRET_KEY => auth enabled (roles enforced).
# - Empty/unset SECRET_KEY => auth disabled.
# SECRET_KEY=change-me

# Stack version reported by the backend API.
VERSION=1.3.1

# Optional Virtuoso overrides (defaults are usually enough).
# VIRTUOSO_ENDPOINT=http://segb-virtuoso:8890/sparql-auth
# VIRTUOSO_GRAPH_URI=http://segb/events
# VIRTUOSO_AUDIT_GRAPH_URI=http://segb/audit
# Seconds between re-checks of the reader's SQL privileges (0 = before every query).
# VIRTUOSO_READER_POLICY_RECHECK_SECONDS=30
# VIRTUOSO_USER=dba
# With an external Virtuoso also set VIRTUOSO_ENDPOINT and VIRTUOSO_ISQL_ADDRESS (its SQL port): the reader is then
# provisioned there, never in the bundled segb-virtuoso container.
# VIRTUOSO_ISQL_ADDRESS=segb-virtuoso:1111

# Optional: image registry overrides for production compose.
# Defaults point to GHCR images linked to gsi-upm/semantic_ethical_glass_box.
# SEGB_BACKEND_IMAGE=ghcr.io/gsi-upm/semantic_ethical_glass_box/segb
# SEGB_FRONTEND_IMAGE=ghcr.io/gsi-upm/semantic_ethical_glass_box/segb-ui
# SEGB_IMAGE_TAG=latest
