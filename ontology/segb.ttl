@prefix : <http://www.gsi.upm.es/ontologies/segb/ns#> .
@prefix amor: <http://www.gsi.upm.es/ontologies/amor/ns#> .
@prefix concept: <http://sw.opencyc.org/concept/> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix oro: <http://kb.openrobots.org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.gsi.upm.es/ontologies/segb/ns>
  a owl:Ontology ;
  rdfs:label "Semantic Ethical Glass Box (SEGB) Ontology"@en ;
  owl:versionInfo "1.0.0"^^xsd:string ;
  owl:versionIRI <http://www.gsi.upm.es/ontologies/segb/ns/1.0.0> ;
  dc:title "Semantic Ethical Glass Box (SEGB) Ontology"@en ;
  dc:creator "Álvaro Carrera Barroso"@en ;
  dc:publisher <http://www.gsi.upm.es> ;
  rdfs:comment "SEGB is an ontology designed for representing logging information generated by different sources in a common Semantic Ethical Glass Box."@en ;
  dc:description "SEGB is an ontology designed for representing logging information generated by different sources in a common Semantic Ethical Glass Box."@en ;
  vann:preferredNamespacePrefix "segb" ;
  vann:preferredNamespaceUri "http://www.gsi.upm.es/ontologies/segb/ns#" .

:LoggedActivity
    a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    owl:unionOf (
        concept:Action 
        oro:RobotResponses 
        oro:Intent 
        mls:Run
    ) ;
    rdfs:label "Logged Activity"@en ;
    rdfs:comment "Represents an activity that is recorded/logged in the SEGB."@en .

:wasPerformedBy
    a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasAssociatedWith ;
    rdfs:domain :LoggedActivity ;
    rdfs:range prov:Agent ;
    rdfs:label "was performed by"@en ;
    rdfs:comment "Represents the relation between a logged activity and the agent that performed it."@en .

:Trigger
    a owl:Class ;
    owl:unionOf (
        prov:Entity 
        prov:Activity
    ) ;
    rdfs:label "Trigger"@en ;
    rdfs:comment "Represents an event that caused/triggered an activity."@en .

:Result
    a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    owl:unionOf (
        prov:Entity 
        prov:Activity
    ) ;
    rdfs:label "Result"@en ;
    rdfs:comment "Represents the result of an activity."@en .

:triggeredBy
    a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasInfluencedBy ;
    rdfs:domain :LoggedActivity ;
    rdfs:range :Trigger ;
    rdfs:label "triggered by"@en ;
    rdfs:comment "Represents the relation between an activity and the event which triggered it."@en .

:triggeredByActivity
    a owl:ObjectProperty ;
    rdfs:subPropertyOf :triggeredBy ;
    rdfs:domain :LoggedActivity ;
    rdfs:range [
        a owl:Class ;
        owl:intersectionOf (
            prov:Activity
            :Trigger
        )
    ] ;
    rdfs:label "triggered by activity"@en ;
    rdfs:comment "Represents the relation between an activity and the event which triggered it, where the event is an activity."@en .

:triggeredByEntity
    a owl:ObjectProperty ;
    rdfs:subPropertyOf :triggeredBy ;
    rdfs:domain :LoggedActivity ;
    rdfs:range [
        a owl:Class ;
        owl:intersectionOf (
            prov:Entity
            :Trigger
        )
    ] ;
    rdfs:label "triggered by entity"@en ;
    rdfs:comment "Represents the relation between an activity and the event which triggered it, where the event is an entity."@en .

:intermediateActivity
    a owl:ObjectProperty ;
    prov:subPropertyOf prov:wasInfluencedBy ;
    rdfs:domain :LoggedActivity ;
    rdfs:range :LoggedActivity ;
    rdfs:label "intermediate activity"@en ;
    rdfs:comment "Represents the relation between a logged activity and another activity that is an intermediate step towards the final result."@en .
:producedResult
    a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasInfluencedBy ;
    rdfs:domain :LoggedActivity ;
    rdfs:range :Result ;
    rdfs:label "produced result"@en ;
    rdfs:comment "Represents the relation between a result and an activity which produced it."@en .

:producedActivityResult
    a owl:ObjectProperty ;
    rdfs:subPropertyOf :producedResult ;
    rdfs:domain :LoggedActivity ;
    rdfs:range [
        a owl:Class ;
        owl:intersectionOf (
            prov:Activity
            :Result
        )
    ] ;
    rdfs:label "produced activity result"@en ;
    rdfs:comment "Represents the relation between a result and an activity which produced it, where the result is an activity."@en .

:producedEntityResult
    a owl:ObjectProperty ;
    rdfs:subPropertyOf :producedResult ;
    rdfs:subPropertyOf prov:generated ;
    rdfs:domain :LoggedActivity ;
    rdfs:range [
        a owl:Class ;
        owl:intersectionOf (
            prov:Entity
            :Result
        )
    ] ;
    rdfs:label "produced entity result"@en ;
    rdfs:comment "Represents the relation between a result and an activity which produced it, where the result is an entity."@en .

:usedMLModel
    a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    owl:equivalentProperty amor:usedMLModel ;
    rdfs:domain prov:Activity ;
    rdfs:range mls:Model ;
    rdfs:label "used machine learning model"@en ;
    rdfs:comment "Represents the fact that an activity has used a Machine Learning Model to produce the result."@en .

:usedDataset
  a owl:ObjectProperty ;
  rdfs:subPropertyOf prov:used ;
  rdfs:label "used dataset"@en ;
  rdfs:domain prov:Activity ;
  rdfs:range [
        a owl:Class ;
        owl:unionOf (
            mls:Dataset
            schema:Dataset
        )
    ] ;
  rdfs:comment "This property relates an activity with the Dataset or the Corpus used to carry out the analysis." .
:usedSoftware
    a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    owl:equivalentProperty amor:usedSoftware ;
    rdfs:domain prov:Activity ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            schema:SoftwareApplication
            mls:Software
            doap:Project
            doap:Version
        )
    ] ;
    rdfs:label "used software"@en ;
    rdfs:comment "Represents the fact that an activity has used a Software to produce the result."@en .

:wasRequestedBy
    a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasAssociatedWith ;
    rdfs:domain :LoggedActivity ;
    rdfs:range prov:Agent ;
    rdfs:label "requested by"@en ;
    rdfs:comment "Represents the relation between a logged activity and the agent that requested it."@en .